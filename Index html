<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZEEKAMSHI Orders Admin</title>
<style>
body{font-family:Arial;background:#0A1931;color:white;padding:15px}
h1{color:#FFD700;text-align:center}
.box{background:white;color:black;padding:15px;border-radius:10px;margin:10px 0}
input{width:95%;padding:10px;margin:5px 0}
button{background:#25D366;color:white;border:none;padding:12px;width:100%;border-radius:8px;font-weight:bold}
.order{background:#FFF8DC;padding:10px;border-radius:8px;margin:10px 0;color:black}
.del{background:green;color:white;padding:5px 10px;border:none;border-radius:5px}
</style>
</head>
<body>
<div id="login">
<h1>ZEEKAMSHI ADMIN</h1>
<div class="box">
<p>Enter Password</p>
<input type="password" id="pass" placeholder="Password">
<button onclick="login()">Enter Admin</button>
<p>Password is: zeekamshi123</p>
</div>
</div>

<div id="main" style="display:none">
<h1>MY ORDERS</h1>
<div class="box">
<input id="cname" placeholder="Customer Name">
<input id="cphone" placeholder="Customer Phone">
<input id="cproduct" placeholder="Product e.g Oil Perfume x2">
<input id="caddress" placeholder="Address e.g Lekki, Lagos">
<button onclick="addOrder()">+ Add New Order</button>
</div>
<div id="list"></div>
<button onclick="localStorage.clear();location.reload()" style="background:red">Clear All Orders</button>
</div>

<script>
function login(){
 if(document.getElementById('pass').value=='zeekamshi123'){
  document.getElementById('login').style.display='none';
  document.getElementById('main').style.display='block';
  show();
 } else { alert('Wrong password'); }
}
function addOrder(){
 let o={name:document.getElementById('cname').value, phone:document.getElementById('cphone').value, product:document.getElementById('cproduct').value, address:document.getElementById('caddress').value, date:new Date().toLocaleString()};
 let arr=JSON.parse(localStorage.getItem('zeek_orders')||'[]');
 arr.unshift(o);
 localStorage.setItem('zeek_orders',JSON.stringify(arr));
 show();
 alert('Order Saved!');
}
function show(){
 let arr=JSON.parse(localStorage.getItem('zeek_orders')||'[]');
 let h='';
 arr.forEach((o,i)=>{
  h+=`<div class="order"><b>${o.name}</b><br>Phone: ${o.phone}<br>Product: ${o.product}<br>Address: ${o.address}<br><small>${o.date}</small><br><br><a href="https://wa.me/${o.phone.replace(/[^0-9]/g,'')}"><button style="background:#25D366;width:auto">Chat Customer</button></a></div>`;
 });
 document.getElementById('list').innerHTML = h || '<p>No orders yet.</p>';
}
</script>
</body>
</html>
